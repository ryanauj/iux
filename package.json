{
  "name": "iux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run gen:ast-graph && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:ast-graph": "tsx scripts/generate-ast-graph.ts",
    "validate:palettes": "tsx scripts/validate-palettes.ts",
    "validate:descriptions": "tsx scripts/validate-descriptions.ts",
    "lint:tokens": "tsx scripts/lint-raw-values.ts",
    "lint:contrast": "tsx scripts/lint-contrast.ts",
    "lint:tier-contrast": "tsx scripts/lint-tier-contrast.ts",
    "test:gates": "tsx scripts/test-gates.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:style-docs": "tsx scripts/generate-style-docs.ts",
    "check": "pnpm run typecheck && pnpm run validate:palettes && pnpm run validate:descriptions && pnpm run lint:tokens && pnpm run lint:contrast && pnpm run lint:tier-contrast && pnpm run test:gates && pnpm run test"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.22.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
