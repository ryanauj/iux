{
  "name": "iux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:palettes": "tsx scripts/validate-palettes.ts",
    "validate:descriptions": "tsx scripts/validate-descriptions.ts",
    "lint:tokens": "tsx scripts/lint-raw-values.ts",
    "test:gates": "tsx scripts/test-gates.ts",
    "gen:style-docs": "tsx scripts/generate-style-docs.ts",
    "check": "pnpm run typecheck && pnpm run validate:palettes && pnpm run validate:descriptions && pnpm run lint:tokens && pnpm run test:gates"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.22.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
